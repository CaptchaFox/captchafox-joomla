{
    "name": "captchafox/joomla",
    "description": "CaptchaFox captcha plugin for Joomla",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Scoria Labs GmbH",
            "homepage": "https://captchafox.com/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "CaptchaFox\\Plugin\\Captcha\\CaptchaFox\\": "plugin/src/",
            "CaptchaFox\\Plugin\\Captcha\\CaptchaFox\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "build": "php build/build.php",
        "test": "phpunit"
    },
    "scripts-descriptions": {
        "build": "Build the installable plugin ZIP into dist/",
        "test": "Run the unit tests"
    }
}
